rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function deckItemValid(deck, index) {
      return deck.size() <= index ||
        (deck[index] is string && deck[index].size() <= 24 &&
         deck[index].matches('^[a-z_]+$'));
    }

    function validLeaderboard() {
      let data = request.resource.data;
      return data.keys().hasAll(['nickname', 'level', 'deck', 'wins', 'losses',
                                 'playMs', 'favorite', 'updatedAt'])
        && data.keys().hasOnly(['nickname', 'level', 'deck', 'wins', 'losses',
                                'playMs', 'favorite', 'updatedAt'])
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 12
        && data.nickname.matches('^[^<>\\r\\n]+$')
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.wins is int && data.wins >= 0 && data.wins <= 99999
        && data.losses is int && data.losses >= 0 && data.losses <= 99999
        && data.playMs is int && data.playMs >= 0 && data.playMs <= 315360000000
        && data.favorite is string && data.favorite.size() <= 24
        && data.favorite.matches('^[a-z_]*$')
        && data.deck is list && data.deck.size() <= 5
        && deckItemValid(data.deck, 0) && deckItemValid(data.deck, 1)
        && deckItemValid(data.deck, 2) && deckItemValid(data.deck, 3)
        && deckItemValid(data.deck, 4)
        && data.updatedAt == request.time;
    }

    match /leaderboard/{userId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create, update: if owner(userId) && validLeaderboard();
      allow delete: if owner(userId);
    }

    match /backups/{userId} {
      allow get: if owner(userId);
      allow list: if false;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 150000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
